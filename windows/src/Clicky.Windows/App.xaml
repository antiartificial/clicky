<Application x:Class="Clicky.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <Color x:Key="GraphiteColor">#17191D</Color>
        <Color x:Key="WarmWhiteColor">#F4F1E8</Color>
        <Color x:Key="SignalLimeColor">#B8E34A</Color>
        <Color x:Key="CoralColor">#FF6B5F</Color>
        <Color x:Key="StudioTealColor">#168A7B</Color>
        <Color x:Key="MeterAmberColor">#F2B544</Color>

        <SolidColorBrush x:Key="GraphiteBrush" Color="{StaticResource GraphiteColor}" />
        <SolidColorBrush x:Key="GraphiteRaisedBrush" Color="#24272C" />
        <SolidColorBrush x:Key="GraphiteLineBrush" Color="#3A3E45" />
        <SolidColorBrush x:Key="WarmWhiteBrush" Color="{StaticResource WarmWhiteColor}" />
        <SolidColorBrush x:Key="SignalLimeBrush" Color="{StaticResource SignalLimeColor}" />
        <SolidColorBrush x:Key="CoralBrush" Color="{StaticResource CoralColor}" />
        <SolidColorBrush x:Key="StudioTealBrush" Color="{StaticResource StudioTealColor}" />
        <SolidColorBrush x:Key="MeterAmberBrush" Color="{StaticResource MeterAmberColor}" />
    </Application.Resources>
</Application>
