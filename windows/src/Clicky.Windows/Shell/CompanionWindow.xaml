<Window x:Class="Clicky.Windows.Shell.CompanionWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:branding="clr-namespace:Clicky.Windows.Branding"
        xmlns:session="clr-namespace:Clicky.Windows.Session"
        Title="{x:Static branding:BrandText.CompanionWindowTitle}"
        Width="344"
        Height="190"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style TargetType="ToolTip">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Foreground" Value="{StaticResource WarmWhiteBrush}" />
            <Setter Property="Background" Value="{StaticResource GraphiteRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GraphiteLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource WarmWhiteBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="{StaticResource GraphiteRaisedBrush}" />
                                <Setter TargetName="ButtonSurface"
                                        Property="BorderBrush"
                                        Value="{StaticResource StudioTealBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="{StaticResource StudioTealBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MeterBarStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="4" />
            <Setter Property="RadiusX" Value="1.5" />
            <Setter Property="RadiusY" Value="1.5" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Fill" Value="{StaticResource SignalLimeBrush}" />
            <Setter Property="Opacity" Value="0.88" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static session:CompanionSessionState.Listening}">
                    <Setter Property="Fill" Value="{StaticResource CoralBrush}" />
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static session:CompanionSessionState.Processing}">
                    <Setter Property="Fill" Value="{StaticResource MeterAmberBrush}" />
                    <Setter Property="Opacity" Value="0.9" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static session:CompanionSessionState.Responding}">
                    <Setter Property="Fill" Value="{StaticResource StudioTealBrush}" />
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="{StaticResource GraphiteRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GraphiteLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource WarmWhiteBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource SignalLimeBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource StudioTealBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ProviderSegmentStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="{StaticResource GraphiteRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GraphiteLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource WarmWhiteBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SegmentSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentSurface"
                                        Property="BorderBrush"
                                        Value="{StaticResource StudioTealBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SegmentSurface"
                                        Property="Opacity"
                                        Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SegmentSurface"
                                        Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{StaticResource StudioTealBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StudioTealBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource WarmWhiteBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionSurface" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionSurface" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MotionToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track"
                                    Background="{StaticResource GraphiteBrush}"
                                    BorderBrush="{StaticResource GraphiteLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10" />
                            <Ellipse x:Name="Thumb"
                                     Width="14"
                                     Height="14"
                                     Margin="3"
                                     HorizontalAlignment="Left"
                                     Fill="{StaticResource WarmWhiteBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource SignalLimeBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource SignalLimeBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource GraphiteBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource StudioTealBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource WarmWhiteBrush}" />
                                <Setter TargetName="Track" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Margin="8"
            Padding="12"
            Background="{StaticResource GraphiteBrush}"
            BorderBrush="{StaticResource GraphiteLineBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="4"
                              Opacity="0.4"
                              Color="{StaticResource GraphiteColor}" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="90" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                    <Border Width="26"
                            Height="26"
                            Margin="0,0,8,0"
                            Background="{StaticResource GraphiteRaisedBrush}"
                            BorderBrush="{StaticResource GraphiteLineBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            ClipToBounds="True">
                        <Image Width="36"
                               Height="36"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Source="/Clicky.Windows;component/Assets/Clicky.png"
                               Stretch="Uniform"
                               AutomationProperties.Name="{x:Static branding:BrandText.ApplicationName}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static branding:BrandText.ApplicationName}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WarmWhiteBrush}" />
                        <Rectangle Width="28"
                                   Height="2"
                                   Margin="0,3,0,0"
                                   HorizontalAlignment="Left"
                                   Fill="{StaticResource SignalLimeBrush}"
                                   RadiusX="1"
                                   RadiusY="1" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Margin="0,0,3,0"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="{x:Static branding:BrandText.OpenSettingsTooltip}"
                        AutomationProperties.Name="{x:Static branding:BrandText.OpenSettingsTooltip}"
                        Click="SettingsButton_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Text="&#xE713;" />
                </Button>

                <Button Grid.Column="2"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="{x:Static branding:BrandText.CloseTooltip}"
                        AutomationProperties.Name="{x:Static branding:BrandText.CloseTooltip}"
                        Click="CloseButton_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Text="&#xE711;" />
                </Button>

                <Border Grid.ColumnSpan="3"
                        VerticalAlignment="Bottom"
                        BorderBrush="{StaticResource GraphiteLineBrush}"
                        BorderThickness="0,0,0,1"
                        IsHitTestVisible="False" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsQuestionEntryVisible}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Width="48"
                        Height="48"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="0,14,0,0"
                        BorderBrush="Transparent"
                        Cursor="Hand"
                        Focusable="False"
                        Command="{Binding AdvanceSessionCommand}"
                        ToolTip="{x:Static branding:BrandText.PrimaryActionTooltip}"
                        AutomationProperties.Name="{x:Static branding:BrandText.PrimaryActionTooltip}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{StaticResource SignalLimeBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8" />
                                            <Border x:Name="PrimaryHover"
                                                    Background="{StaticResource WarmWhiteBrush}"
                                                    CornerRadius="8"
                                                    Opacity="0" />
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="PrimaryHover" Property="Opacity" Value="0.14" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="PrimaryHover" Property="Opacity" Value="0.28" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}"
                                             Value="{x:Static session:CompanionSessionState.Listening}">
                                    <Setter Property="Background" Value="{StaticResource CoralBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}"
                                             Value="{x:Static session:CompanionSessionState.Processing}">
                                    <Setter Property="Background" Value="{StaticResource MeterAmberBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}"
                                             Value="{x:Static session:CompanionSessionState.Responding}">
                                    <Setter Property="Background" Value="{StaticResource StudioTealBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource WarmWhiteBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               Text="&#xE720;" />
                </Button>

                <Grid Grid.Column="2"
                      Margin="0,13,0,0"
                      VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="9" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="36"
                              Height="22"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,1">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleY="1" />
                            </Grid.RenderTransform>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding State}"
                                                           Value="{x:Static session:CompanionSessionState.Listening}" />
                                                <Condition Binding="{Binding IsMotionEffectivelyEnabled}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard Name="ListeningMeterAnimation">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.58"
                                                                         To="1"
                                                                         Duration="0:0:0.32"
                                                                         AutoReverse="True"
                                                                         RepeatBehavior="Forever" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         From="0.76"
                                                                         To="1"
                                                                         Duration="0:0:0.32"
                                                                         AutoReverse="True"
                                                                         RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <RemoveStoryboard BeginStoryboardName="ListeningMeterAnimation" />
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding State}"
                                                           Value="{x:Static session:CompanionSessionState.Processing}" />
                                                <Condition Binding="{Binding IsMotionEffectivelyEnabled}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard Name="ProcessingMeterAnimation">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.42"
                                                                         To="0.95"
                                                                         Duration="0:0:0.72"
                                                                         AutoReverse="True"
                                                                         RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <RemoveStoryboard BeginStoryboardName="ProcessingMeterAnimation" />
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Rectangle Height="7"
                                       HorizontalAlignment="Left"
                                       Style="{StaticResource MeterBarStyle}" />
                            <Rectangle Height="13"
                                       Margin="8,0,0,0"
                                       HorizontalAlignment="Left"
                                       Style="{StaticResource MeterBarStyle}" />
                            <Rectangle Height="20"
                                       Margin="16,0,0,0"
                                       HorizontalAlignment="Left"
                                       Style="{StaticResource MeterBarStyle}" />
                            <Rectangle Height="14"
                                       Margin="24,0,0,0"
                                       HorizontalAlignment="Left"
                                       Style="{StaticResource MeterBarStyle}" />
                            <Rectangle Height="8"
                                       Margin="32,0,0,0"
                                       HorizontalAlignment="Left"
                                       Style="{StaticResource MeterBarStyle}" />
                        </Grid>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding StatusText}"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource WarmWhiteBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}"
                                                     Value="{x:Static session:CompanionSessionState.Listening}">
                                            <Setter Property="Foreground" Value="{StaticResource CoralBrush}" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding State}"
                                                           Value="{x:Static session:CompanionSessionState.Listening}" />
                                                <Condition Binding="{Binding IsMotionEffectivelyEnabled}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.5"
                                                                         To="1"
                                                                         Duration="0:0:0.16" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding State}"
                                                     Value="{x:Static session:CompanionSessionState.Processing}">
                                            <Setter Property="Foreground" Value="{StaticResource MeterAmberBrush}" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding State}"
                                                           Value="{x:Static session:CompanionSessionState.Processing}" />
                                                <Condition Binding="{Binding IsMotionEffectivelyEnabled}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.5"
                                                                         To="1"
                                                                         Duration="0:0:0.16" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding State}"
                                                     Value="{x:Static session:CompanionSessionState.Responding}">
                                            <Setter Property="Foreground" Value="{StaticResource StudioTealBrush}" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding State}"
                                                           Value="{x:Static session:CompanionSessionState.Responding}" />
                                                <Condition Binding="{Binding IsMotionEffectivelyEnabled}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.5"
                                                                         To="1"
                                                                         Duration="0:0:0.16" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               MinHeight="16"
                               MaxHeight="32"
                               Margin="45,2,0,0"
                               VerticalAlignment="Top"
                               Text="{Binding StatusDetail}"
                               FontSize="11"
                               LineHeight="14"
                               LineStackingStrategy="BlockLineHeight"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource WarmWhiteBrush}"
                               Opacity="0.58" />
                </Grid>

                <Button Grid.Column="3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,14,0,0"
                        Style="{StaticResource IconButtonStyle}"
                        Command="{Binding CancelSessionCommand}"
                        ToolTip="{x:Static branding:BrandText.CancelActionTooltip}"
                        AutomationProperties.Name="{x:Static branding:BrandText.CancelActionTooltip}">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Text="&#xE71A;" />
                </Button>
            </Grid>

            <Grid Grid.Row="1"
                  Visibility="{Binding IsQuestionEntryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>

                <Border Height="50"
                        Margin="0,13,0,0"
                        VerticalAlignment="Top"
                        Background="{StaticResource GraphiteRaisedBrush}"
                        BorderBrush="{StaticResource StudioTealBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <TextBox x:Name="QuestionTextBox"
                             Padding="9,7"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource WarmWhiteBrush}"
                             CaretBrush="{StaticResource SignalLimeBrush}"
                             SelectionBrush="{StaticResource StudioTealBrush}"
                             FontSize="12"
                             TextWrapping="Wrap"
                             AcceptsReturn="False"
                             VerticalContentAlignment="Center"
                             AutomationProperties.Name="{x:Static branding:BrandText.QuestionInputLabel}"
                             Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="QuestionTextBox_KeyDown" />
                </Border>

                <Button Grid.Column="2"
                        Margin="0,23,0,0"
                        VerticalAlignment="Top"
                        Focusable="True"
                        Style="{StaticResource IconButtonStyle}"
                        Command="{Binding SubmitQuestionCommand}"
                        ToolTip="{x:Static branding:BrandText.SubmitQuestionTooltip}"
                        AutomationProperties.Name="{x:Static branding:BrandText.SubmitQuestionTooltip}">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Text="&#xE724;" />
                </Button>
            </Grid>

            <Border Grid.Row="2"
                    Padding="0,11,0,0"
                    BorderBrush="{StaticResource GraphiteLineBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="{Binding IsSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Width="304">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Width="4"
                                   Height="16"
                                   VerticalAlignment="Center"
                                   Fill="{StaticResource CoralBrush}"
                                   RadiusX="2"
                                   RadiusY="2" />
                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Text="{x:Static branding:BrandText.SettingsHeading}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WarmWhiteBrush}" />
                    </Grid>

                    <TextBlock Text="{x:Static branding:BrandText.AiProviderLabel}"
                               Margin="0,0,0,4"
                               FontSize="11"
                               Foreground="{StaticResource WarmWhiteBrush}"
                               Opacity="0.62" />
                    <UniformGrid Columns="3" Margin="0,0,0,10">
                        <Button Click="WorkerProviderButton_Click"
                                AutomationProperties.Name="{x:Static branding:BrandText.WorkerProviderLabel}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ProviderSegmentStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWorkerProvider}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SignalLimeBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource SignalLimeBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{x:Static branding:BrandText.WorkerProviderLabel}" />
                        </Button>
                        <Button Margin="4,0"
                                Click="AnthropicProviderButton_Click"
                                AutomationProperties.Name="{x:Static branding:BrandText.AnthropicProviderLabel}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ProviderSegmentStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAnthropicProvider}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CoralBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource CoralBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{x:Static branding:BrandText.AnthropicProviderLabel}" />
                        </Button>
                        <Button Click="OpenAIProviderButton_Click"
                                AutomationProperties.Name="{x:Static branding:BrandText.OpenAIProviderLabel}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ProviderSegmentStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOpenAIProvider}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource StudioTealBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource StudioTealBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{x:Static branding:BrandText.OpenAIProviderLabel}" />
                        </Button>
                    </UniformGrid>

                    <StackPanel Visibility="{Binding IsWorkerProvider, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{x:Static branding:BrandText.WorkerBaseUrlLabel}"
                                   Margin="0,0,0,4"
                                   FontSize="11"
                                   Foreground="{StaticResource WarmWhiteBrush}"
                                   Opacity="0.62" />
                        <TextBox Margin="0,0,0,10"
                                 Style="{StaticResource SettingsTextBoxStyle}"
                                 AutomationProperties.Name="{x:Static branding:BrandText.WorkerBaseUrlLabel}"
                                 Text="{Binding Settings.WorkerBaseUrl, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsAnthropicProvider, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{x:Static branding:BrandText.ModelIdLabel}"
                                   Margin="0,0,0,4"
                                   FontSize="11"
                                   Foreground="{StaticResource WarmWhiteBrush}"
                                   Opacity="0.62" />
                        <TextBox Margin="0,0,0,8"
                                 Style="{StaticResource SettingsTextBoxStyle}"
                                 AutomationProperties.Name="Anthropic model ID"
                                 Text="{Binding Settings.AnthropicModelId, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsOpenAIProvider, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{x:Static branding:BrandText.ModelIdLabel}"
                                   Margin="0,0,0,4"
                                   FontSize="11"
                                   Foreground="{StaticResource WarmWhiteBrush}"
                                   Opacity="0.62" />
                        <TextBox Margin="0,0,0,8"
                                 Style="{StaticResource SettingsTextBoxStyle}"
                                 AutomationProperties.Name="OpenAI model ID"
                                 Text="{Binding Settings.OpenAIModelId, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsDirectProvider, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{x:Static branding:BrandText.ApiKeyLabel}"
                                   Margin="0,0,0,4"
                                   FontSize="11"
                                   Foreground="{StaticResource WarmWhiteBrush}"
                                   Opacity="0.62" />
                        <PasswordBox x:Name="ProviderApiKeyPasswordBox"
                                     Height="30"
                                     Padding="8,5"
                                     Margin="0,0,0,7"
                                     Background="{StaticResource GraphiteRaisedBrush}"
                                     BorderBrush="{StaticResource GraphiteLineBrush}"
                                     BorderThickness="1"
                                     Foreground="{StaticResource WarmWhiteBrush}"
                                     CaretBrush="{StaticResource SignalLimeBrush}"
                                     IsEnabled="{Binding CanSaveApiKey}"
                                     AutomationProperties.Name="{x:Static branding:BrandText.ApiKeyLabel}" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource SettingsActionButtonStyle}"
                                    IsEnabled="{Binding CanSaveApiKey}"
                                    Click="SaveApiKeyButton_Click"
                                    Content="{Binding SaveApiKeyButtonText}"
                                    AutomationProperties.Name="{Binding SaveApiKeyButtonText}" />
                            <Button Grid.Column="2"
                                    Style="{StaticResource SettingsActionButtonStyle}"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource GraphiteLineBrush}"
                                    Command="{Binding RemoveApiKeyCommand}"
                                    Content="{x:Static branding:BrandText.RemoveApiKeyLabel}"
                                    AutomationProperties.Name="{x:Static branding:BrandText.RemoveApiKeyLabel}" />
                            <TextBlock Grid.Column="3"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="10"
                                       Foreground="{StaticResource WarmWhiteBrush}"
                                       Opacity="0.64"
                                       Text="{Binding ApiKeyStatusText}" />
                        </Grid>
                    </StackPanel>

                    <Border Height="42"
                            Margin="0,0,0,8"
                            Background="{StaticResource GraphiteRaisedBrush}"
                            BorderBrush="{StaticResource GraphiteLineBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid Margin="9,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{StaticResource WarmWhiteBrush}"
                                       Text="{x:Static branding:BrandText.MotionEffectsLabel}" />
                            <ToggleButton Grid.Column="1"
                                          Margin="8,0,10,0"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource MotionToggleStyle}"
                                          IsChecked="{Binding Settings.MotionEffectsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          AutomationProperties.Name="{x:Static branding:BrandText.MotionEffectsLabel}" />
                            <Border Grid.Column="2"
                                    Height="22"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource GraphiteLineBrush}" />
                            <TextBlock Grid.Column="3"
                                       Margin="10,0,6,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{StaticResource WarmWhiteBrush}"
                                       Opacity="0.72"
                                       Text="{x:Static branding:BrandText.FootPedalKeyLabel}" />
                            <ComboBox Grid.Column="4"
                                      Height="26"
                                      Padding="6,2"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource GraphiteBrush}"
                                      BorderBrush="{StaticResource GraphiteLineBrush}"
                                      Foreground="{StaticResource GraphiteBrush}"
                                      ItemsSource="{Binding PushToTalkKeys}"
                                      SelectedItem="{Binding Settings.PushToTalkKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="{x:Static branding:BrandText.FootPedalKeyLabel}" />
                        </Grid>
                    </Border>

                    <Border MinHeight="36"
                            Background="{StaticResource GraphiteRaisedBrush}"
                            BorderBrush="{StaticResource GraphiteLineBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            IsHitTestVisible="False">
                        <Grid Margin="9,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{StaticResource StudioTealBrush}"
                                       Text="&#xE7F4;" />
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{StaticResource WarmWhiteBrush}"
                                       Opacity="0.62"
                                       Text="{x:Static branding:BrandText.CaptureScopeLabel}" />
                            <TextBlock Grid.Column="2"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SignalLimeBrush}"
                                       Text="{x:Static branding:BrandText.ActiveWindowCaptureScope}" />
                        </Grid>
                    </Border>

                    <Border Height="36"
                            Margin="0,8,0,0"
                            Background="{StaticResource GraphiteRaisedBrush}"
                            BorderBrush="{StaticResource GraphiteLineBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid Margin="9,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="OptimizeLargeCapturesCheckBox"
                                      VerticalAlignment="Center"
                                      Foreground="{StaticResource WarmWhiteBrush}"
                                      FocusVisualStyle="{x:Null}"
                                      IsChecked="{Binding Settings.OptimizeLargeCaptures, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="Optimize large captures">
                                <CheckBox.Template>
                                    <ControlTemplate TargetType="CheckBox">
                                        <Grid Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="CheckSurface"
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Background="{StaticResource GraphiteBrush}"
                                                    BorderBrush="{StaticResource GraphiteLineBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                <TextBlock x:Name="CheckGlyph"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource GraphiteBrush}"
                                                           Text="&#xE73E;"
                                                           Visibility="Collapsed" />
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Margin="7,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="{StaticResource WarmWhiteBrush}"
                                                       Text="Optimize large captures" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="CheckSurface" Property="Background" Value="{StaticResource SignalLimeBrush}" />
                                                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource SignalLimeBrush}" />
                                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource StudioTealBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource WarmWhiteBrush}" />
                                                <Setter TargetName="CheckSurface" Property="BorderThickness" Value="2" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </CheckBox.Template>
                            </CheckBox>
                            <TextBlock Grid.Column="1"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SignalLimeBrush}"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Off" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.OptimizeLargeCaptures}" Value="True">
                                                <Setter Property="Text" Value="On" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
