<Window x:Class="Clicky.Windows.Shell.CompanionWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:branding="clr-namespace:Clicky.Windows.Branding"
        xmlns:session="clr-namespace:Clicky.Windows.Session"
        Title="{x:Static branding:BrandText.CompanionWindowTitle}"
        Width="344"
        Height="190"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style TargetType="ToolTip">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Foreground" Value="{StaticResource WarmWhiteBrush}" />
            <Setter Property="Background" Value="{StaticResource GraphiteRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GraphiteLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="PolishedButtonChromeStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource WarmWhiteBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource GraphiteLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ChromeRoot"
                              Background="Transparent"
                              ClipToBounds="True"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>

                            <Border x:Name="HoverGlow"
                                    Margin="3"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource StudioTealBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    IsHitTestVisible="False"
                                    Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="5"
                                                      Color="{StaticResource StudioTealColor}"
                                                      Opacity="0.9"
                                                      RenderingBias="Performance"
                                                      ShadowDepth="0" />
                                </Border.Effect>
                            </Border>

                            <Border x:Name="ButtonSurface"
                                    Margin="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                <Grid>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="True" />
                                    <Border x:Name="InteractionOverlay"
                                            Background="{StaticResource WarmWhiteBrush}"
                                            CornerRadius="4"
                                            IsHitTestVisible="False"
                                            Opacity="0" />
                                </Grid>
                            </Border>

                            <Border x:Name="KeyboardFocusRing"
                                    Margin="2"
                                    BorderBrush="{StaticResource WarmWhiteBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="BorderBrush"
                                        Value="{StaticResource StudioTealBrush}" />
                                <Setter TargetName="InteractionOverlay"
                                        Property="Opacity"
                                        Value="0.08" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0.18" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="KeyboardFocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}"
                                               Value="True" />
                                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}"
                                               Value="True" />
                                    <Condition Binding="{Binding DataContext.IsMotionEffectivelyEnabled, RelativeSource={RelativeSource TemplatedParent}}"
                                               Value="True" />
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.72"
                                                             Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ChromeRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.02"
                                                             Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ChromeRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.02"
                                                             Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ChromeRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1"
                                                             Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ChromeRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1"
                                                             Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ChromeRoot" Property="Opacity" Value="0.38" />
                                <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PolishedButtonChromeStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style x:Key="MeterBarStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="4" />
            <Setter Property="RadiusX" Value="1.5" />
            <Setter Property="RadiusY" Value="1.5" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Fill" Value="{StaticResource SignalLimeBrush}" />
            <Setter Property="Opacity" Value="0.88" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static session:CompanionSessionState.Listening}">
                    <Setter Property="Fill" Value="{StaticResource CoralBrush}" />
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static session:CompanionSessionState.Processing}">
                    <Setter Property="Fill" Value="{StaticResource MeterAmberBrush}" />
                    <Setter Property="Opacity" Value="0.9" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static session:CompanionSessionState.Responding}">
                    <Setter Property="Fill" Value="{StaticResource StudioTealBrush}" />
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

