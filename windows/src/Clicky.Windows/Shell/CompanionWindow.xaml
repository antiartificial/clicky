                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track"
                                    Background="{StaticResource GraphiteBrush}"
                                    BorderBrush="{StaticResource GraphiteLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10" />
