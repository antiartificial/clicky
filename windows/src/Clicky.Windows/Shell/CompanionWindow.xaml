        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="{StaticResource GraphiteRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GraphiteLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource WarmWhiteBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource SignalLimeBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource StudioTealBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ProviderSegmentStyle"
               TargetType="Button"
               BasedOn="{StaticResource PolishedButtonChromeStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Background" Value="{StaticResource GraphiteRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GraphiteLineBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="SettingsActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PolishedButtonChromeStyle}">
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="{StaticResource StudioTealBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StudioTealBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MotionToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track"
                                    Background="{StaticResource GraphiteBrush}"
                                    BorderBrush="{StaticResource GraphiteLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10" />
                            <Ellipse x:Name="Thumb"
                                     Width="14"
                                     Height="14"
                                     Margin="3"
                                     HorizontalAlignment="Left"
                                     Fill="{StaticResource WarmWhiteBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource SignalLimeBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource SignalLimeBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource GraphiteBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource StudioTealBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource WarmWhiteBrush}" />
                                <Setter TargetName="Track" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Margin="8"
            Padding="12"
            Background="{StaticResource GraphiteBrush}"
            BorderBrush="{StaticResource GraphiteLineBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="4"
                              Opacity="0.4"
                              Color="{StaticResource GraphiteColor}" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="90" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                    <Border Width="26"
                            Height="26"
                            Margin="0,0,8,0"
                            Background="{StaticResource GraphiteRaisedBrush}"
                            BorderBrush="{StaticResource GraphiteLineBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            ClipToBounds="True">
                        <Image Width="36"
                               Height="36"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Source="/Clicky.Windows;component/Assets/Clicky.png"
                               Stretch="Uniform"
                               AutomationProperties.Name="{x:Static branding:BrandText.ApplicationName}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static branding:BrandText.ApplicationName}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WarmWhiteBrush}" />
                        <Rectangle Width="28"
                                   Height="2"
                                   Margin="0,3,0,0"
                                   HorizontalAlignment="Left"
                                   Fill="{StaticResource SignalLimeBrush}"
                                   RadiusX="1"
                                   RadiusY="1" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Margin="0,0,3,0"
                        ToolTip="{x:Static branding:BrandText.ConversationTooltip}"
                        AutomationProperties.Name="{x:Static branding:BrandText.ConversationTooltip}"
                        Click="ConversationButton_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource HeaderTextButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConversationVisible}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource StudioTealBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource StudioTealBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="16" Height="16">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Text="&#xE8BD;" />
                        <Ellipse Width="4"
                                 Height="4"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Fill="{StaticResource SignalLimeBrush}"
                                 Visibility="{Binding HasConversation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        <TextBlock Margin="5,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Text="{x:Static branding:BrandText.ConversationButtonLabel}" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Margin="0,0,3,0"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="{x:Static branding:BrandText.OpenSettingsTooltip}"
                        AutomationProperties.Name="{x:Static branding:BrandText.OpenSettingsTooltip}"
                        Click="SettingsButton_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Text="&#xE713;" />
                </Button>

                <Button Grid.Column="3"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="{x:Static branding:BrandText.CloseTooltip}"
                        AutomationProperties.Name="{x:Static branding:BrandText.CloseTooltip}"
                        Click="CloseButton_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Text="&#xE711;" />
                </Button>

                <Border Grid.ColumnSpan="4"
                        VerticalAlignment="Bottom"
                        BorderBrush="{StaticResource GraphiteLineBrush}"
                        BorderThickness="0,0,0,1"
                        IsHitTestVisible="False" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsQuestionEntryVisible}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="PrimaryActionButton"
                        Grid.Column="0"
                        Width="48"
                        Height="48"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="0,14,0,0"
                        BorderBrush="Transparent"
                        Cursor="Hand"
                        Focusable="False"
                        Command="{Binding AdvanceSessionCommand}"
                        ToolTip="{x:Static branding:BrandText.PrimaryActionTooltip}"
                        AutomationProperties.Name="{x:Static branding:BrandText.PrimaryActionTooltip}">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource PolishedButtonChromeStyle}">
                            <Setter Property="Background" Value="{StaticResource SignalLimeBrush}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}" />
                            <Setter Property="Focusable" Value="False" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}"
                                             Value="{x:Static session:CompanionSessionState.Listening}">
                                    <Setter Property="Background" Value="{StaticResource CoralBrush}" />
                                    <Setter Property="Opacity" Value="0.92" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}"
                                             Value="{x:Static session:CompanionSessionState.Processing}">
                                    <Setter Property="Background" Value="{StaticResource MeterAmberBrush}" />
                                    <Setter Property="Opacity" Value="0.92" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}"
                                             Value="{x:Static session:CompanionSessionState.Responding}">
                                    <Setter Property="Background" Value="{StaticResource StudioTealBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource WarmWhiteBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid Width="30"
                          Height="30"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                                                       Value="True" />
                                            <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}"
                                                       Value="True" />
                                            <Condition Binding="{Binding IsMotionEffectivelyEnabled}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.EnterActions>
                                            <BeginStoryboard Name="MicrophoneHoverAnimation">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                     To="1.08" Duration="0:0:0.09" AutoReverse="True">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                     To="1.08" Duration="0:0:0.09" AutoReverse="True">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </MultiDataTrigger.EnterActions>
                                        <MultiDataTrigger.ExitActions>
                                            <RemoveStoryboard BeginStoryboardName="MicrophoneHoverAnimation" />
                                        </MultiDataTrigger.ExitActions>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Ellipse Margin="2"
                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                 StrokeThickness="1.25"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="0.78" ScaleY="0.78" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Opacity" Value="0" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding State}" Value="{x:Static session:CompanionSessionState.Listening}" />
                                                <Condition Binding="{Binding IsMotionEffectivelyEnabled}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard Name="ListeningMicrophoneRingAnimation">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.08" To="0.42" Duration="0:0:0.32"
                                                                         AutoReverse="True" RepeatBehavior="Forever" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         From="0.76" To="1.02" Duration="0:0:0.32"
                                                                         AutoReverse="True" RepeatBehavior="Forever" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         From="0.76" To="1.02" Duration="0:0:0.32"
                                                                         AutoReverse="True" RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <RemoveStoryboard BeginStoryboardName="ListeningMicrophoneRingAnimation" />
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding State}" Value="{x:Static session:CompanionSessionState.Processing}" />
                                                <Condition Binding="{Binding IsMotionEffectivelyEnabled}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard Name="ProcessingMicrophoneRingAnimation">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.12" To="0.34" Duration="0:0:0.58"
                                                                         AutoReverse="True" RepeatBehavior="Forever" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         From="0.82" To="1.04" Duration="0:0:0.58"
                                                                         AutoReverse="True" RepeatBehavior="Forever" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         From="0.82" To="1.04" Duration="0:0:0.58"
                                                                         AutoReverse="True" RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <RemoveStoryboard BeginStoryboardName="ProcessingMicrophoneRingAnimation" />
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding State}" Value="{x:Static session:CompanionSessionState.Responding}" />
                                                <Condition Binding="{Binding IsMotionEffectivelyEnabled}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard Name="RespondingMicrophoneRingAnimation">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.08" To="0.24" Duration="0:0:0.95"
                                                                         AutoReverse="True" RepeatBehavior="Forever" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         From="0.9" To="1.03" Duration="0:0:0.95"
                                                                         AutoReverse="True" RepeatBehavior="Forever" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         From="0.9" To="1.03" Duration="0:0:0.95"
                                                                         AutoReverse="True" RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <RemoveStoryboard BeginStoryboardName="RespondingMicrophoneRingAnimation" />
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse Margin="1"
                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                 StrokeThickness="1"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="0.7" ScaleY="0.7" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Opacity" Value="0" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                                                           Value="True" />
                                                <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}"
                                                           Value="True" />
                                                <Condition Binding="{Binding IsMotionEffectivelyEnabled}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard Name="MicrophoneHoverRingAnimation">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="0.42" Duration="0:0:0.14"
                                                                         AutoReverse="True" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         From="0.7" To="1.06" Duration="0:0:0.14"
                                                                         AutoReverse="True" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         From="0.7" To="1.06" Duration="0:0:0.14"
                                                                         AutoReverse="True" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <RemoveStoryboard BeginStoryboardName="MicrophoneHoverRingAnimation" />
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   Text="&#xE720;" />
                    </Grid>
                </Button>

                <Grid Grid.Column="2"
                      Margin="0,13,0,0"
                      VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="9" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="36"
                              Height="22"
                              ClipToBounds="True"
                              VerticalAlignment="Center">
                            <Rectangle Height="20"
                                       HorizontalAlignment="Left"
                                       RenderTransformOrigin="0.5,1"
                                       Style="{StaticResource AnalyzerBar1Style}">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleY="0.35" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Height="20"
                                       Margin="8,0,0,0"
                                       HorizontalAlignment="Left"
                                       RenderTransformOrigin="0.5,1"
                                       Style="{StaticResource AnalyzerBar2Style}">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleY="0.65" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Height="20"
                                       Margin="16,0,0,0"
                                       HorizontalAlignment="Left"
                                       RenderTransformOrigin="0.5,1"
                                       Style="{StaticResource AnalyzerBar3Style}">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleY="1" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Height="20"
                                       Margin="24,0,0,0"
                                       HorizontalAlignment="Left"
                                       RenderTransformOrigin="0.5,1"
                                       Style="{StaticResource AnalyzerBar4Style}">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleY="0.7" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Height="20"
                                       Margin="32,0,0,0"
                                       HorizontalAlignment="Left"
                                       RenderTransformOrigin="0.5,1"
                                       Style="{StaticResource AnalyzerBar5Style}">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleY="0.4" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding StatusText}"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource WarmWhiteBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}"
                                                     Value="{x:Static session:CompanionSessionState.Listening}">
                                            <Setter Property="Foreground" Value="{StaticResource CoralBrush}" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding State}"
                                                           Value="{x:Static session:CompanionSessionState.Listening}" />
                                                <Condition Binding="{Binding IsMotionEffectivelyEnabled}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.5"
                                                                         To="1"
                                                                         Duration="0:0:0.16" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding State}"
                                                     Value="{x:Static session:CompanionSessionState.Processing}">
                                            <Setter Property="Foreground" Value="{StaticResource MeterAmberBrush}" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding State}"
                                                           Value="{x:Static session:CompanionSessionState.Processing}" />
                                                <Condition Binding="{Binding IsMotionEffectivelyEnabled}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.5"
                                                                         To="1"
                                                                         Duration="0:0:0.16" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding State}"
                                                     Value="{x:Static session:CompanionSessionState.Responding}">
                                            <Setter Property="Foreground" Value="{StaticResource StudioTealBrush}" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding State}"
                                                           Value="{x:Static session:CompanionSessionState.Responding}" />
                                                <Condition Binding="{Binding IsMotionEffectivelyEnabled}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.5"
                                                                         To="1"
                                                                         Duration="0:0:0.16" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <TextBlock x:Name="StatusDetailTextBlock"
                               Grid.Row="1"
                               MinHeight="16"
                               VerticalAlignment="Top"
                               Text="{Binding StatusDetail}"
                               FontSize="11"
                               LineHeight="14"
                               LineStackingStrategy="BlockLineHeight"
                               ToolTip="{Binding StatusDetail}"
                               Foreground="{StaticResource WarmWhiteBrush}"
                               Opacity="0.58">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="MaxHeight" Value="32" />
                                <Setter Property="Margin" Value="45,2,0,0" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="TextTrimming" Value="None" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConversationVisible}" Value="False">
                                        <Setter Property="MaxHeight" Value="30" />
                                        <Setter Property="Margin" Value="45,2,76,0" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="StatusDetailTranslateTransform" />
                        </TextBlock.RenderTransform>
                    </TextBlock>

                    <Button Grid.Row="1"
                            Padding="6,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Click="OpenConversationButton_Click"
                            ToolTip="{x:Static branding:BrandText.OpenConversationTooltip}"
                            AutomationProperties.Name="{x:Static branding:BrandText.OpenConversationTooltip}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource HeaderTextButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasConversation}" Value="True" />
                                            <Condition Binding="{Binding IsConversationVisible}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,4,0"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Text="&#xE8BD;" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="10"
                                       Text="{x:Static branding:BrandText.OpenConversationLabel}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Button Grid.Column="3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,14,0,0"
                        Command="{Binding CancelSessionCommand}"
                        ToolTip="{x:Static branding:BrandText.CancelActionTooltip}"
                        AutomationProperties.Name="{x:Static branding:BrandText.CancelActionTooltip}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Text="&#xE71A;" />
                </Button>
            </Grid>

            <Grid Grid.Row="1"
                  Visibility="{Binding IsQuestionEntryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>

                <Border Height="50"
                        Margin="0,13,0,0"
                        VerticalAlignment="Top"
                        Background="{StaticResource GraphiteRaisedBrush}"
                        BorderBrush="{StaticResource StudioTealBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <TextBox x:Name="QuestionTextBox"
                             Padding="9,7"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource WarmWhiteBrush}"
                             CaretBrush="{StaticResource SignalLimeBrush}"
                             SelectionBrush="{StaticResource StudioTealBrush}"
                             FontSize="12"
                             TextWrapping="Wrap"
                             AcceptsReturn="False"
                             VerticalContentAlignment="Center"
                             AutomationProperties.Name="{x:Static branding:BrandText.QuestionInputLabel}"
                             Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="QuestionTextBox_KeyDown" />
                </Border>

                <Button Grid.Column="2"
                        Margin="0,23,0,0"
                        VerticalAlignment="Top"
                        Focusable="True"
                        Style="{StaticResource IconButtonStyle}"
                        Command="{Binding SubmitQuestionCommand}"
                        ToolTip="{x:Static branding:BrandText.SubmitQuestionTooltip}"
                        AutomationProperties.Name="{x:Static branding:BrandText.SubmitQuestionTooltip}">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Text="&#xE724;" />
                </Button>
            </Grid>

            <Border Grid.Row="2"
                    Padding="0,11,0,0"
                    BorderBrush="{StaticResource GraphiteLineBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="{Binding IsConversationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Width="4"
                                   Height="16"
                                   VerticalAlignment="Center"
                                   Fill="{StaticResource StudioTealBrush}"
                                   RadiusX="2"
                                   RadiusY="2" />
                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{x:Static branding:BrandText.ConversationHeading}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WarmWhiteBrush}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding ClearConversationCommand}"
                                    ToolTip="{x:Static branding:BrandText.ClearConversationTooltip}"
                                    AutomationProperties.Name="{x:Static branding:BrandText.ClearConversationTooltip}"
                                    Visibility="{Binding HasConversation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Text="&#xE74D;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ListBox Grid.Row="1"
                             Height="92"
                             Margin="0,7,0,0"
                             Padding="0"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding StoredConversations}"
                             SelectedItem="{Binding SelectedStoredConversation, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Visibility="{Binding HasStoredConversations, Converter={StaticResource BooleanToVisibilityConverter}}"
                             AutomationProperties.Name="{x:Static branding:BrandText.ConversationHistoryLabel}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="7,5" />
                                <Setter Property="Margin" Value="0,0,0,3" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource WarmWhiteBrush}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="HistorySurface"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{StaticResource GraphiteLineBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HistorySurface" Property="Background" Value="{StaticResource GraphiteRaisedBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="HistorySurface" Property="Background" Value="{StaticResource GraphiteRaisedBrush}" />
                                                    <Setter TargetName="HistorySurface" Property="BorderBrush" Value="{StaticResource StudioTealBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource WarmWhiteBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Title, TargetNullValue=Untitled conversation}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="10"
                                                   Foreground="{StaticResource WarmWhiteBrush}"
                                                   Opacity="0.55"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding RollingSummary, TargetNullValue=No summary yet}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Margin="8,0,0,0"
                                               FontSize="9"
                                               Foreground="{StaticResource StudioTealBrush}"
                                               Text="{Binding Provider}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ScrollViewer x:Name="ConversationScrollViewer"
                                  Grid.Row="2"
                                  Height="205"
                                  Margin="0,8,0,0"
                                  VerticalAlignment="Top"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding ConversationTurns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,12">
                                                <Border MaxWidth="300"
                                                        Padding="9,7"
                                                        HorizontalAlignment="Right"
                                                        Background="{StaticResource StudioTealBrush}"
                                                        BorderBrush="{StaticResource StudioTealBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                    <StackPanel>
                                                        <TextBlock Margin="0,0,0,3"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource GraphiteBrush}"
                                                                   Opacity="0.7"
                                                                   Text="You" />
                                                        <TextBlock FontSize="12"
                                                                   LineHeight="16"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{StaticResource GraphiteBrush}"
                                                                   Text="{Binding UserText}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border MaxWidth="300"
                                                        Margin="0,7,0,0"
                                                        Padding="9,7"
                                                        HorizontalAlignment="Left"
                                                        Background="{StaticResource GraphiteRaisedBrush}"
                                                        BorderBrush="{StaticResource GraphiteLineBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                    <StackPanel>
                                                        <TextBlock Margin="0,0,0,3"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource SignalLimeBrush}"
                                                                   Text="{x:Static branding:BrandText.ApplicationName}" />
                                                        <TextBlock FontSize="12"
                                                                   LineHeight="16"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{StaticResource WarmWhiteBrush}"
                                                                   Text="{Binding AssistantText}" />
                                                        <Button Margin="0,7,0,0"
                                                                Padding="7,3"
                                                                HorizontalAlignment="Left"
                                                                Style="{StaticResource HeaderTextButtonStyle}"
                                                                Command="{Binding DataContext.ReplayPointCueCommand, ElementName=RootWindow}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{x:Static branding:BrandText.ShowMeTooltip}"
                                                                AutomationProperties.Name="{x:Static branding:BrandText.ShowMeTooltip}"
                                                                Visibility="{Binding HasInteractionTarget, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Margin="0,0,5,0"
                                                                           VerticalAlignment="Center"
                                                                           FontFamily="Segoe MDL2 Assets"
                                                                           FontSize="12"
                                                                           Foreground="{StaticResource CoralBrush}"
                                                                           Text="&#xE81D;" />
                                                                <TextBlock VerticalAlignment="Center"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Text="{x:Static branding:BrandText.ShowMeLabel}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border MaxWidth="300"
                                        Padding="9,7"
                                        HorizontalAlignment="Right"
                                        Background="{StaticResource StudioTealBrush}"
                                        BorderBrush="{StaticResource StudioTealBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="{Binding HasActiveQuestion, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,3"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource GraphiteBrush}"
                                                   Opacity="0.7"
                                                   Text="You" />
                                        <TextBlock FontSize="12"
                                                   LineHeight="16"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource GraphiteBrush}"
                                                   Text="{Binding ActiveQuestionText}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{StaticResource WarmWhiteBrush}"
                                       Opacity="0.48"
                                       Text="{x:Static branding:BrandText.EmptyConversation}"
                                       Visibility="{Binding IsConversationEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="3"
                            Height="48"
                            Margin="0,10,0,0"
                            Background="{StaticResource GraphiteRaisedBrush}"
                            BorderBrush="{StaticResource GraphiteLineBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            IsEnabled="{Binding CanContinueActiveConversation}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="38" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FollowUpTextBox"
                                     Padding="10,7"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource WarmWhiteBrush}"
                                     CaretBrush="{StaticResource SignalLimeBrush}"
                                     SelectionBrush="{StaticResource StudioTealBrush}"
                                     FontSize="12"
                                     TextWrapping="NoWrap"
                                     AcceptsReturn="False"
                                     VerticalContentAlignment="Center"
                                     AutomationProperties.Name="{x:Static branding:BrandText.FollowUpInputLabel}"
                                     Text="{Binding FollowUpQuestion, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="FollowUpTextBox_KeyDown" />
                            <TextBlock Margin="10,0,44,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{StaticResource WarmWhiteBrush}"
                                       Opacity="0.38"
                                       IsHitTestVisible="False"
                                       Text="{x:Static branding:BrandText.FollowUpPlaceholder}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FollowUpQuestion}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="1"
                                    Margin="2"
                                    Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding SubmitFollowUpCommand}"
                                    ToolTip="{x:Static branding:BrandText.SubmitFollowUpTooltip}"
                                    AutomationProperties.Name="{x:Static branding:BrandText.SubmitFollowUpTooltip}">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Text="&#xE724;" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Padding="0,11,0,0"
                    BorderBrush="{StaticResource GraphiteLineBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="{Binding IsSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Width="4"
                                   Height="16"
                                   VerticalAlignment="Center"
                                   Fill="{StaticResource CoralBrush}"
                                   RadiusX="2"
                                   RadiusY="2" />
                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Text="{x:Static branding:BrandText.SettingsHeading}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WarmWhiteBrush}" />
                    </Grid>

                    <TextBlock Text="{x:Static branding:BrandText.AiProviderLabel}"
                               Margin="0,0,0,4"
                               FontSize="11"
                               Foreground="{StaticResource WarmWhiteBrush}"
                               Opacity="0.62" />
                    <UniformGrid Columns="3" Margin="0,0,0,10">
                        <Button Click="GeminiProviderButton_Click"
                                AutomationProperties.Name="{x:Static branding:BrandText.GeminiProviderLabel}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ProviderSegmentStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGeminiProvider}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SignalLimeBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource SignalLimeBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" VerticalAlignment="Center">
