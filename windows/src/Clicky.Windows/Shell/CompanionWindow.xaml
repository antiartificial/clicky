<Window x:Class="Clicky.Windows.Shell.CompanionWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:branding="clr-namespace:Clicky.Windows.Branding"
        xmlns:session="clr-namespace:Clicky.Windows.Session"
        Title="{x:Static branding:BrandText.CompanionWindowTitle}"
        Width="380"
        Height="190"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style TargetType="ToolTip">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Foreground" Value="{StaticResource WarmWhiteBrush}" />
            <Setter Property="Background" Value="{StaticResource GraphiteRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GraphiteLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="PolishedButtonChromeStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource WarmWhiteBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource GraphiteLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ChromeRoot"
                              Background="Transparent"
                              ClipToBounds="True"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>

                            <Border x:Name="HoverGlow"
                                    Margin="3"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource StudioTealBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    IsHitTestVisible="False"
                                    Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="5"
                                                      Color="{StaticResource StudioTealColor}"
                                                      Opacity="0.9"
                                                      RenderingBias="Performance"
                                                      ShadowDepth="0" />
                                </Border.Effect>
                            </Border>

                            <Border x:Name="ButtonSurface"
                                    Margin="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                <Grid>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="True" />
                                    <Border x:Name="InteractionOverlay"
                                            Background="{StaticResource WarmWhiteBrush}"
                                            CornerRadius="4"
                                            IsHitTestVisible="False"
                                            Opacity="0" />
                                </Grid>
                            </Border>

                            <Border x:Name="KeyboardFocusRing"
                                    Margin="2"
                                    BorderBrush="{StaticResource WarmWhiteBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0.18" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="KeyboardFocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}"
                                               Value="True" />
                                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}"
                                               Value="True" />
                                    <Condition Binding="{Binding DataContext.IsMotionEffectivelyEnabled, RelativeSource={RelativeSource TemplatedParent}}"
                                               Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0.08" />
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.72"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ChromeRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.02"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ChromeRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.02"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ChromeRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ChromeRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}"
                                               Value="True" />
                                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}"
                                               Value="True" />
                                    <Condition Binding="{Binding DataContext.IsMotionEffectivelyEnabled, RelativeSource={RelativeSource TemplatedParent}}"
                                               Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="ButtonSurface"
                                        Property="BorderBrush"
                                        Value="{StaticResource StudioTealBrush}" />
                                <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0.08" />
                            </MultiDataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ChromeRoot" Property="Opacity" Value="0.38" />
                                <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="{StaticResource GraphiteRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource WarmWhiteBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ComboItemSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource GraphiteLineBrush}"
                                BorderThickness="0,0,0,1">
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ComboItemSurface" Property="Background" Value="{StaticResource GraphiteBrush}" />
                                <Setter TargetName="ComboItemSurface" Property="BorderBrush" Value="{StaticResource StudioTealBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource WarmWhiteBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ComboItemSurface" Property="Background" Value="{StaticResource GraphiteBrush}" />
                                <Setter TargetName="ComboItemSurface" Property="BorderBrush" Value="{StaticResource SignalLimeBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboItemSurface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PolishedButtonChromeStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style x:Key="HeaderTextButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PolishedButtonChromeStyle}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style x:Key="MeterBarStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="4" />
            <Setter Property="RadiusX" Value="1.5" />
            <Setter Property="RadiusY" Value="1.5" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Fill" Value="{StaticResource SignalLimeBrush}" />
            <Setter Property="Opacity" Value="0.88" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static session:CompanionSessionState.Listening}">
                    <Setter Property="Fill" Value="{StaticResource CoralBrush}" />
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static session:CompanionSessionState.Processing}">
                    <Setter Property="Fill" Value="{StaticResource MeterAmberBrush}" />
                    <Setter Property="Opacity" Value="0.9" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static session:CompanionSessionState.Responding}">
                    <Setter Property="Fill" Value="{StaticResource StudioTealBrush}" />
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AnalyzerBar1Style"
               TargetType="Rectangle"
               BasedOn="{StaticResource MeterBarStyle}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding State}" Value="{x:Static session:CompanionSessionState.Listening}" />
                        <Condition Binding="{Binding IsMotionEffectivelyEnabled}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard Name="ListeningBar1Animation">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.58" To="1.12" Duration="0:0:0.28"
                                                 AutoReverse="True" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="ListeningBar1Animation" />
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding State}" Value="{x:Static session:CompanionSessionState.Processing}" />
                        <Condition Binding="{Binding IsMotionEffectivelyEnabled}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard Name="ProcessingBar1Animation">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0.3" To="1" Duration="0:0:0.38"
                                                 AutoReverse="True" RepeatBehavior="Forever" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.3" To="0.74" Duration="0:0:0.38"
                                                 AutoReverse="True" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="ProcessingBar1Animation" />
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding State}" Value="{x:Static session:CompanionSessionState.Responding}" />
                        <Condition Binding="{Binding IsMotionEffectivelyEnabled}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard Name="RespondingBar1Animation">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.88" To="1.05" Duration="0:0:1.1"
                                                 AutoReverse="True" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="RespondingBar1Animation" />
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding State}" Value="{x:Static session:CompanionSessionState.Idle}" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True" />
                        <Condition Binding="{Binding IsMotionEffectivelyEnabled}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard Name="IdleHoverBar1Animation">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.18" Duration="0:0:0.1" AutoReverse="True" FillBehavior="Stop" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="IdleHoverBar1Animation" />
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding State}" Value="{x:Static session:CompanionSessionState.Responding}" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True" />
                        <Condition Binding="{Binding IsMotionEffectivelyEnabled}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard Name="RespondingHoverBar1Animation">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.16" Duration="0:0:0.1" AutoReverse="True" FillBehavior="Stop" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="RespondingHoverBar1Animation" />
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

