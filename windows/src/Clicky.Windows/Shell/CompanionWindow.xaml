                                                 To="1.14" BeginTime="0:0:0.035" Duration="0:0:0.1"
                                                 AutoReverse="True" FillBehavior="Stop" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="IdleHoverBar2Animation" />
                    </MultiDataTrigger.ExitActions>
