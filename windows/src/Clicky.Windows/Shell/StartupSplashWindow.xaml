<Window x:Class="Clicky.Windows.Shell.StartupSplashWindow"
        x:Name="SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clicky"
        Width="344"
        Height="224"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        IsTabStop="False"
        Opacity="0"
        AutomationProperties.Name="Clicky startup"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <CubicEase x:Key="IntroEase" EasingMode="EaseOut" />
        <QuadraticEase x:Key="OutroEase" EasingMode="EaseIn" />

        <Storyboard x:Key="IntroStoryboard">
            <DoubleAnimation Storyboard.TargetName="SplashWindow"
                             Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="1"
                             Duration="0:0:0.24"
                             EasingFunction="{StaticResource IntroEase}" />
            <DoubleAnimation Storyboard.TargetName="SplashScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.96"
                             To="1"
                             Duration="0:0:0.34"
                             EasingFunction="{StaticResource IntroEase}" />
            <DoubleAnimation Storyboard.TargetName="SplashScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.96"
                             To="1"
                             Duration="0:0:0.34"
                             EasingFunction="{StaticResource IntroEase}" />
            <DoubleAnimation Storyboard.TargetName="FocusRing"
                             Storyboard.TargetProperty="Opacity"
                             BeginTime="0:0:0.12"
                             From="0.62"
                             To="0"
                             Duration="0:0:0.76" />
            <DoubleAnimation Storyboard.TargetName="FocusRingScale"
                             Storyboard.TargetProperty="ScaleX"
                             BeginTime="0:0:0.12"
                             From="0.82"
                             To="1.16"
                             Duration="0:0:0.76"
                             EasingFunction="{StaticResource IntroEase}" />
            <DoubleAnimation Storyboard.TargetName="FocusRingScale"
                             Storyboard.TargetProperty="ScaleY"
                             BeginTime="0:0:0.12"
                             From="0.82"
                             To="1.16"
                             Duration="0:0:0.76"
                             EasingFunction="{StaticResource IntroEase}" />
        </Storyboard>

        <Storyboard x:Key="OutroStoryboard">
            <DoubleAnimation Storyboard.TargetName="SplashWindow"
                             Storyboard.TargetProperty="Opacity"
                             To="0"
                             Duration="0:0:0.22"
                             EasingFunction="{StaticResource OutroEase}" />
            <DoubleAnimation Storyboard.TargetName="SplashScale"
                             Storyboard.TargetProperty="ScaleX"
                             To="0.985"
                             Duration="0:0:0.22"
                             EasingFunction="{StaticResource OutroEase}" />
            <DoubleAnimation Storyboard.TargetName="SplashScale"
                             Storyboard.TargetProperty="ScaleY"
                             To="0.985"
                             Duration="0:0:0.22"
                             EasingFunction="{StaticResource OutroEase}" />
        </Storyboard>
    </Window.Resources>

    <Border Margin="12"
            Background="{StaticResource GraphiteBrush}"
            BorderBrush="{StaticResource GraphiteLineBrush}"
            BorderThickness="1"
            CornerRadius="8"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="SplashScale" ScaleX="0.96" ScaleY="0.96" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="5"
                              Opacity="0.46"
                              Color="{StaticResource GraphiteColor}" />
        </Border.Effect>

        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="104" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Width="96" Height="96" HorizontalAlignment="Center">
                <Ellipse x:Name="FocusRing"
                         Width="90"
                         Height="90"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Stroke="{StaticResource SignalLimeBrush}"
                         StrokeThickness="2"
                         Opacity="0"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="FocusRingScale" ScaleX="0.82" ScaleY="0.82" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Image Width="82"
                       Height="82"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Source="/Clicky.Windows;component/Assets/Clicky.png"
                       Stretch="Uniform"
                       AutomationProperties.Name="Clicky logo" />
            </Grid>

            <TextBlock Grid.Row="1"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource WarmWhiteBrush}"
                       FontSize="27"
                       FontWeight="SemiBold"
                       Text="Clicky" />
            <TextBlock Grid.Row="2"
                       Margin="0,3,0,0"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource WarmWhiteBrush}"
                       FontSize="11"
                       Opacity="0.62"
                       Text="See it. Learn it." />
        </Grid>
    </Border>
</Window>
